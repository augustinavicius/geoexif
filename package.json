{
  "name": "geoexif",
  "version": "1.1.0",
  "description": "Fast GPS EXIF data viewer with simple features.",
  "main": "app.js",
  "scripts": {
    "dev": "electron .",
    "build-app": "electron-builder build --win --publish never",
    "deploy-app": "electron-builder build --win --publish always",
    "build-sass": "sass --quiet-deps styledefs.scss src/styles/sass.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/augustinavicius/geoexif"
  },
  "keywords": [],
  "author": "augustinavicius",
  "license": "MIT",
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bulma": "^0.9.4",
    "bulma-list": "^1.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "sass": "^1.100.0"
  },
  "dependencies": {
    "custom-electron-titlebar": "^4.4.1",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.3",
    "fast-exif": "^1.1.0",
    "leaflet": "^1.9.4",
    "leaflet-edgebuffer": "^1.0.7",
    "leaflet-zoombox": "^0.5.2",
    "leaflet.tilelayer.nogap": "^0.3.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "productName": "GEOEXIF",
    "compression": "maximum",
    "win": {
      "publish": [
        "github"
      ]
    },
    "nsis": {
      "oneClick": "false",
      "allowToChangeInstallationDirectory": "true"
    },
    "directories": {
      "buildResources": "buildResources",
      "output": "release"
    }
  }
}
